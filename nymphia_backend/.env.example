# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.

# Chave secreta para assinar os tokens JWT.
# Gere uma: python -c "import secrets; print(secrets.token_hex(32))"
NYMPHIA_SECRET_KEY=troque-isso-antes-de-publicar-de-verdade

# URL do banco de dados. SQLite para desenvolvimento, PostgreSQL em produção.
# Railway injeta DATABASE_URL automaticamente quando o plugin Postgres está ativo.
NYMPHIA_DATABASE_URL=sqlite:///./nymphia.db

# Troca de banco sem baixar nada: ponha aqui o endereço do banco ANTIGO e o do
# banco NOVO (vazio) em NYMPHIA_DATABASE_URL. Na próxima inicialização o
# servidor copia tudo, uma vez (detalhes em app/copia_de_banco.py).
# NYMPHIA_DATABASE_URL_ANTIGO=

# Memória do servidor em MB. Sem isso, o servidor descobre sozinho (no Render
# grátis, 512). Abaixo de 1024, os dois modelos mais pesados ficam desligados.
# NYMPHIA_LIMITE_MEMORIA_MB=

# Caminho da pasta com os modelos ML (.joblib e pasta bertimbau_nymphia/).
# Em produção, aponta pro volume do Railway onde os modelos foram copiados.
NYMPHIA_MODELOS_DIR=/app/modelos

# Caminho do arquivo de log de emergências.
NYMPHIA_LOG_EMERGENCIAS=emergencias.log

# --- Adicionado em 15/10/2026 ---

# Ambiente. Em "production" o servidor se recusa a ligar se NYMPHIA_SECRET_KEY
# estiver vazia, curta (menos de 32 caracteres) ou igual ao valor do repositório.
ENVIRONMENT=development

# Token da equipe para aprovar profissionais (rotas /admin e
# scripts/admin_profissionais.py). Sem ele, a área da equipe fica desligada.
# Gere um: python -c "import secrets; print(secrets.token_urlsafe(48))"
NYMPHIA_ADMIN_TOKEN=

# Endereço público do app, usado no link do e-mail de redefinição de senha.
NYMPHIA_URL_PUBLICA=https://nymphia-global.onrender.com

# Envio de e-mail (redefinição de senha e aviso de aprovação).
# Sem SMTP, nenhum e-mail sai e a pessoa é orientada a falar com o suporte.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Quantos proxies existem na frente do servidor (para achar o IP real no
# limite de tentativas de login). Render ou Coolify/Traefik: 1.
# Com Cloudflare na frente do Coolify: 2.
NYMPHIA_PROXIES_CONFIAVEIS=1
